# Copy to .env.local and fill in. Without keys the app runs fully in Simulated mode
# and the Web Voice Call falls back to the browser's built-in speech engines.

# Sarvam AI (https://dashboard.sarvam.ai) â€” used for STT, TTS, translation and the LLM
SARVAM_API_KEY=


# Optional overrides
# bulbul:v3 (default, falls back to bulbul:v2 automatically if a request fails)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b
# off (default, fastest + most reliable) | low | medium | high
SARVAM_LLM_REASONING=off

# Outbound PSTN telephony adapter (not wired by default). Set to "exotel" or "twilio"
# once credentials and a PNS-mapped caller ID are approved; until then the
# Call Seller button offers Web Voice and Simulated modes only.
TELEPHONY_PROVIDER=none
