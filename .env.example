# Copy to .env.local and fill in. Never commit .env.local.
# Without a key the app still runs: the web voice call falls back to the browser's
# built-in speech engines and replies come from templates.

# Sarvam AI (https://dashboard.sarvam.ai): STT, TTS, translation and the LLM
SARVAM_API_KEY=

# Optional overrides
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b
# off (default, fastest + most reliable) | low | medium | high
SARVAM_LLM_REASONING=off
# Voice expressiveness 0-1 (default 0.75)
# SARVAM_TTS_TEMPERATURE=0.75
# Default voices (any Bulbul v3 speaker), defaults neha / rahul
# SARVAM_FEMALE_SPEAKER=neha
# SARVAM_MALE_SPEAKER=rahul

# Storage folder for seller profiles and calls (default ./data).
# On Vercel / serverless set: DATA_DIR=/tmp/voice-agent-data
# DATA_DIR=

# Serverless only: shared store so every server instance sees the same calls/profiles.
# Added automatically when you connect "Upstash for Redis" in Vercel → Storage. Not needed locally.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Outbound PSTN telephony adapter: not implemented yet (placeholder for Exotel / Twilio).
TELEPHONY_PROVIDER=none
